; Лабиринт: экран заполняется случайными диагоналями — классика из 1978 года.
; Когда экран заполнен, любая клавиша рисует новый лабиринт.

start:
        CLS
        LD V0, 0            ; x
        LD V1, 0            ; y
cell:
        LD I, left
        RND V2, 1
        SE V2, 1
        LD I, right
        DRW V0, V1, 4
        ADD V0, 4
        SE V0, 64
        JP cell
        LD V0, 0
        ADD V1, 4
        SE V1, 32
        JP cell

        LD V3, K
        JP start

left:   DB 0b10000000, 0b01000000, 0b00100000, 0b00010000
right:  DB 0b00010000, 0b00100000, 0b01000000, 0b10000000
